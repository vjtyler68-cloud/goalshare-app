<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push Notifications capability. MUST be "production" for the shipped app:
	     an explicit aps-environment is NOT auto-promoted by Xcode, so a
	     "development" value made TestFlight/App Store builds register SANDBOX
	     APNs tokens, which FCM's production send rejects with
	     ApnsError 403 BadEnvironmentKeyInToken — the real cause of the push
	     failure. All iOS builds here are Codemagic distribution builds (there is
	     no local debug iOS build on a Windows dev machine), so "production" is
	     both correct and signs cleanly. Paired with setAPNSToken(_, type: .prod)
	     in AppDelegate so the token env reported to FCM matches. -->
	<key>aps-environment</key>
	<string>production</string>
	<!-- HealthKit capability. Enabled on the com.goal.share App ID in the Apple
	     Developer portal, so this entitlement is authorized and the Codemagic
	     distribution profile signs cleanly. Base HealthKit only — no clinical
	     health-records access, so com.apple.developer.healthkit.access is
	     intentionally omitted. -->
	<key>com.apple.developer.healthkit</key>
	<true/>
</dict>
</plist>
